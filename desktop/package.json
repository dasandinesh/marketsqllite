{
  "name": "market-desktop",
  "version": "1.3.1",
  "description": "Offline SQLite billing with optional Atlas synchronization",
  "author": "Market",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "prepare:app": "node scripts/prepare.js",
    "start": "npm run prepare:app && node scripts/launch.js",
    "build:win": "npm run prepare:app && electron-builder --win nsis --x64 --publish never",
    "test": "node --test tests/*.test.js",
    "test:packaged": "node scripts/smoke.js"
  },
  "dependencies": { "electron-updater": "6.8.9" },
  "devDependencies": { "electron": "44.7.0", "electron-builder": "26.15.3" },
  "build": {
    "appId": "com.market.billing.sqlite",
    "productName": "Market Billing",
    "asar": true,
    "directories": { "output": "../dist/desktop" },
    "files": ["main.js", "updates.js", "runtime.js", "smoke-check.js", "package.json"],
    "extraResources": [
      { "from": "staging/app-code", "to": "app-code" },
      { "from": "staging/runtime", "to": "runtime" }
    ],
    "publish": [{ "provider": "github", "owner": "dasandinesh", "repo": "marketsqllite", "releaseType": "release" }],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "artifactName": "Market-Billing-Setup-${version}-${arch}.${ext}" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Market Billing",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
