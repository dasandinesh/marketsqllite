PORT=8000
NODE_ENV=development
DB_ENGINE=mongodb
DB_LOCAL_URL=mongodb://127.0.0.1:27017/market

# Used by npm run start:sqlite; relative paths are resolved from the back folder.
SQLITE_FILE=data/market.sqlite

# Optional: require this key when accessing the Atlas Sync settings page.
# Set a strong private value before enabling administration over the network.
ATLAS_SYNC_ADMIN_TOKEN=
